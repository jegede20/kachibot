# ── Telegram ─────────────────────────────────────────────
# token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# optional: comma list of numeric telegram ids allowed to use the bot
# TELEGRAM_ALLOWED_USER_IDS=11111111,22222222

# ── Solana RPC (single provider, no fallback by design) ──
# free tier: https://www.helius.dev (devnet/mainnet) or default public RPC
SOLANA_NETWORK=mainnet
RPC_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY   # default: https://api.mainnet-beta.solana.com
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY       # default: wss://api.mainnet-beta.solana.com

# optional Helius Digital Asset Standard url -> prettier token symbols/names
# HELIUS_DAS_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ── Secrets (required) ───────────────────────────────────
# 32-byte base64 key OR a long passphrase (>=16 chars). Used for AES-256-GCM
# encryption of imported wallet keys. Keep it safe — losing it loses access.
ENCRYPTION_KEY=
# KACHI_MASTER_PASSPHRASE=some long random passphrase you will remember

# ── Storage: Supabase free tier (optional) ───────────────
# leave empty -> local JSON file store in ./data/db.json (zero infra)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# (run supabase/schema.sql once in the SQL editor when using Supabase)

# ── Jito (mainnet speed lane; fees come from trade funds) ─
# JITO_RPC_URL=https://mainnet.block-engine.jito.wtf
# JITO_TIP_ACCOUNTS=96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5,HFqU5x63VTqvQss8hp11i4wVV8bD44PvwucfZ2bU7gRe,...

# ── Optional: Jupiter API key (higher rate limits) ───────
# JUPITER_API_KEY=
